---
// =============================================================================
// LAYOUT BASE
// -----------------------------------------------------------------------------
// Estructura común de TODAS las páginas: <head>, cabecera, contenido y pie.
// Cada página lo usa así:
//   <Base title="Título de la pestaña" description="Texto para buscadores">
//     ...contenido...
//   </Base>
// =============================================================================
import '../styles/global.css';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import { url } from '../lib/url';
import { SITIO } from '../config/sitio';

interface Props {
  title: string;
  description?: string;
}
const { title, description = SITIO.descripcion } = Astro.props;
---
<!doctype html>
<html lang="es">
  <head>
    <!-- ===== Metadatos ===== -->
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#00497A" />
    <link rel="icon" type="image/png" href={url('/logo.png')} />

    <!-- ===== Tipografías (Google Fonts) ===== -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500..800&family=Figtree:wght@400;500;600&display=swap" rel="stylesheet" />

    <title>{title}</title>
  </head>
  <body>
    <!-- Enlace para saltar al contenido (accesibilidad con teclado) -->
    <a class="skip" href="#contenido">Saltar al contenido</a>

    <!-- ===== CABECERA (logo + menú) ===== -->
    <Header />

    <!-- ===== CONTENIDO DE CADA PÁGINA ===== -->
    <main id="contenido" class="wrap"><slot /></main>

    <!-- ===== PIE DE PÁGINA ===== -->
    <Footer />
  </body>
</html>
