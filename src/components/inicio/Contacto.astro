---
// =============================================================================
// SECCIÓN 5 · CONTACTO
// Texto y enlace en src/content/secciones/contacto.md
// Para cambiar el repositorio, edita `enlace.url` en ese archivo.
// =============================================================================
import { getEntry, render } from 'astro:content';
import TituloSeccion from '../comunes/TituloSeccion.astro';

const seccion = await getEntry('secciones', 'contacto');
if (!seccion) throw new Error('Falta src/content/secciones/contacto.md');
const { Content } = await render(seccion);
const enlace = seccion.data.enlace;
---
<section id="contacto" class="section contact" aria-labelledby="contacto-titulo">
  <!-- ----- Texto ----- -->
  <div>
    <TituloSeccion id="contacto-titulo" titulo={seccion.data.titulo} etiqueta={seccion.data.etiqueta} />
    <div class="prose"><Content /></div>
  </div>

  <!-- ----- Tarjeta de GitHub ----- -->
  {enlace && (
    <a class="gh-card" href={enlace.url} target="_blank" rel="noopener">
      <!-- Ícono de GitHub (SVG en línea, sin dependencias) -->
      <svg class="gh-icon" viewBox="0 0 24 24" width="40" height="40" aria-hidden="true">
        <path fill="currentColor" d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.1.79-.25.79-.56v-2c-3.2.7-3.87-1.37-3.87-1.37-.52-1.33-1.28-1.69-1.28-1.69-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.18 1.76 1.18 1.03 1.76 2.69 1.25 3.35.96.1-.75.4-1.25.73-1.54-2.55-.29-5.24-1.28-5.24-5.68 0-1.25.45-2.28 1.18-3.08-.12-.29-.51-1.46.11-3.04 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.77 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.58.23 2.75.11 3.04.74.8 1.18 1.83 1.18 3.08 0 4.41-2.69 5.39-5.25 5.67.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5Z"/>
      </svg>
      <span class="gh-text">
        <strong>{enlace.texto}</strong>
        {enlace.detalle && <span>{enlace.detalle}</span>}
      </span>
      <span class="gh-arrow" aria-hidden="true">↗</span>
    </a>
  )}
</section>
