---
// =============================================================================
// PÁGINA DE CADA PROYECTO  ( /proyectos/<id>/ )
// Se genera una página por cada archivo de src/content/proyectos/
// =============================================================================
import Base from '../../layouts/Base.astro';
import ListaEquipo from '../../components/comunes/ListaEquipo.astro';
import { getCollection, render } from 'astro:content';
import { url } from '../../lib/url';

// Le dice a Astro qué páginas crear (una por proyecto)
export async function getStaticPaths() {
  const proyectos = await getCollection('proyectos');
  return proyectos.map((p) => ({ params: { id: p.id }, props: { p } }));
}

const { p } = Astro.props;
const { Content } = await render(p);
const equipo = (await getCollection('integrantes')).filter((i) => i.data.proyecto === p.id);
---
<Base title={`${p.data.titulo} | KBS`} description={p.data.resumen}>
  <article class="page">
    <!-- ----- Navegación ----- -->
    <a class="back" href={url('/#proyectos')}>← Volver a proyectos</a>

    <!-- ----- Encabezado ----- -->
    <h1><span class={`badge c-${p.data.color}`}></span>{p.data.titulo}</h1>
    <p class="lead">{p.data.resumen}</p>
    <p class="meta"><strong>Para:</strong> {p.data.usuario}</p>
    <ul class="tags">{p.data.etiquetas.map((t) => <li>{t}</li>)}</ul>

    <!-- ----- Contenido (Markdown del proyecto) ----- -->
    <div class="prose"><Content /></div>

    <!-- ----- Equipo del proyecto ----- -->
    {equipo.length > 0 && (
      <>
        <h2>Equipo</h2>
        <ListaEquipo integrantes={equipo} />
      </>
    )}
  </article>
</Base>
